# API base URL used by the SPA (src/lib/api.js reads VITE_API_URL).
# - Local dev:   frontend/.env            -> http://localhost:8000/api
# - Prod build:  frontend/.env.production -> https://smartlog-api.jezyk.me/api
VITE_API_URL=http://localhost:8000/api

# Reverb (WebSocket) — must match backend .env REVERB_* values
# (backend/.env's VITE_REVERB_* lines do nothing for Vite; put them here)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
